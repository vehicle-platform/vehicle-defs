# vehicle-platform VSS overlay (D-004) on top of COVESA VSS 6.0 (base pinned in
# tools/codegen/src/vehicle_codegen/gen_vss.py). Consumed by kuksa-can-provider
# (dbc2vss keys) together with dbc/platform.dbc on the Raspi. Output:
# gen/vss/vss_dbc.json (`make gen`).
#
# Rules:
# - Standard COVESA paths where one exists. Vehicle.Motorcycle.* extensions need the
#   user's approval first (D-004; approved set: D-028); tools/codegen rejects any
#   other unknown path.
# - Safety-path signals may be mirrored here for display/logging only; no safety
#   decision ever reads VSS (ARCHITECTURE section 5).
# - kuksa-can-provider cannot gate a value on a *_VALID bit; consumers must treat
#   Vehicle.* values as display data (VALID bits are in platform.dbc).

Vehicle.Speed:
  type: sensor
  datatype: float
  dbc2vss:
    signal: VEHICLE_SPEED
    interval_ms: 100

Vehicle.Powertrain.CombustionEngine.Speed:
  type: sensor
  datatype: float
  dbc2vss:
    signal: ENGINE_SPEED
    interval_ms: 100

Vehicle.Powertrain.CombustionEngine.EngineCoolant.Temperature:
  type: sensor
  datatype: float
  dbc2vss:
    signal: COOLANT_TEMP
    interval_ms: 1000

Vehicle.LowVoltageBattery.CurrentVoltage:
  type: sensor
  datatype: float
  dbc2vss:
    signal: BATTERY_VOLTAGE
    interval_ms: 1000

# --------------------------------------------------------------------------
# Vehicle.Motorcycle.* extensions (approved by the user, D-028). Display,
# logging, MCP and ML use only; safety decisions read platform CAN directly.

Vehicle.Motorcycle:
  type: branch
  description: Motorcycle-specific signals (vehicle-platform extension, D-028).

Vehicle.Motorcycle.LeanAngle:
  type: sensor
  datatype: float
  unit: degrees
  min: -90
  max: 90
  description: Roll (lean) angle estimated by the rt-core EKF. Positive = leaning right.
  dbc2vss:
    signal: LEAN_ANGLE
    interval_ms: 50

Vehicle.Motorcycle.LeanAngleQuality:
  type: sensor
  datatype: uint8
  unit: percent
  min: 0
  max: 100
  description: Estimator confidence of the lean angle; 0 = no confidence.
  dbc2vss:
    signal: LEAN_ANGLE_QUALITY
    interval_ms: 100

Vehicle.Motorcycle.LeanAngleState:
  type: sensor
  datatype: string
  allowed: [ESTIMATED, CLAMPED, INVALID]
  description: State of the lean angle estimate. There is no default lean angle (D-029).
  dbc2vss:
    signal: LEAN_ANGLE_STATE
    interval_ms: 100
    transform:
      mapping:
        - from: ESTIMATED
          to: ESTIMATED
        - from: CLAMPED
          to: CLAMPED
        - from: RESERVED
          to: INVALID
        - from: INVALID
          to: INVALID

Vehicle.Motorcycle.FrictionCoefficient:
  type: sensor
  datatype: float
  min: 0
  max: 2
  description: Tyre-road friction coefficient mu estimated by the rt-core EKF (dimensionless).
  dbc2vss:
    signal: FRICTION_COEFF
    interval_ms: 100

Vehicle.Motorcycle.FrictionCoefficientQuality:
  type: sensor
  datatype: uint8
  unit: percent
  min: 0
  max: 100
  description: Estimator confidence of the friction coefficient; 0 = no confidence.
  dbc2vss:
    signal: FRICTION_COEFF_QUALITY
    interval_ms: 100

Vehicle.Motorcycle.FrictionCoefficientState:
  type: sensor
  datatype: string
  allowed: [ESTIMATED, CLAMPED, DEFAULT, INVALID]
  description: State of the friction estimate. DEFAULT = rt-core fallback value from limits/platform_limits.yaml (D-029), not an estimate.
  dbc2vss:
    signal: FRICTION_COEFF_STATE
    interval_ms: 100
    transform:
      mapping:
        - from: ESTIMATED
          to: ESTIMATED
        - from: CLAMPED
          to: CLAMPED
        - from: DEFAULT
          to: DEFAULT
        - from: INVALID
          to: INVALID

Vehicle.Motorcycle.EstimatedMass:
  type: sensor
  datatype: float
  unit: kg
  min: 0
  max: 1000
  description: Total mass (vehicle + rider + load) estimated by the rt-core EKF.
  dbc2vss:
    signal: TOTAL_MASS
    interval_ms: 100

Vehicle.Motorcycle.EstimatedMassQuality:
  type: sensor
  datatype: uint8
  unit: percent
  min: 0
  max: 100
  description: Estimator confidence of the mass estimate; 0 = no confidence.
  dbc2vss:
    signal: TOTAL_MASS_QUALITY
    interval_ms: 100

Vehicle.Motorcycle.EstimatedMassState:
  type: sensor
  datatype: string
  allowed: [ESTIMATED, CLAMPED, DEFAULT, INVALID]
  description: State of the mass estimate. DEFAULT = rt-core fallback value from limits/platform_limits.yaml (D-029), not an estimate.
  dbc2vss:
    signal: TOTAL_MASS_STATE
    interval_ms: 100
    transform:
      mapping:
        - from: ESTIMATED
          to: ESTIMATED
        - from: CLAMPED
          to: CLAMPED
        - from: DEFAULT
          to: DEFAULT
        - from: INVALID
          to: INVALID

Vehicle.Motorcycle.ThrottlePosition:
  type: sensor
  datatype: float
  unit: percent
  min: 0
  max: 100
  description: Throttle valve opening from the ECU TPS (J1979 PID 0x11), not the twist-grip demand.
  dbc2vss:
    signal: THROTTLE_POS
    interval_ms: 100

Vehicle.Motorcycle.IsEcuPresent:
  type: sensor
  datatype: boolean
  description: True if the engine ECU answered a UDS request within the ECU-absent timeout.
  dbc2vss:
    signal: ECU_PRESENT
    interval_ms: 1000
    transform:
      mapping:
        - from: ABSENT
          to: false
        - from: PRESENT
          to: true

# --------------------------------------------------------------------------
# Node health (D-108, PROVISIONAL: Claude's decision, the user revises; Q-016).
# One branch per platform-bus node, mapped by the unique heartbeat signal names
# <NODE>_NODE_MODE / _ERROR_COUNT / _UPTIME (kuksa-can-provider maps by signal name).

Vehicle.Motorcycle.Nodes:
  type: branch
  description: Health of the platform-bus nodes, from their heartbeats 0x081-0x085 (D-108, provisional).

Vehicle.Motorcycle.Nodes.RtCore:
  type: branch
  description: Heartbeat of the RT_CORE node.

Vehicle.Motorcycle.Nodes.RtCore.Mode:
  type: sensor
  datatype: string
  allowed: [INIT, NORMAL, DEGRADED, SAFE_STATE, BOOTLOADER, DIAGNOSTIC]
  description: Node mode from the RT_CORE heartbeat (RT_CORE_NODE_MODE). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: RT_CORE_NODE_MODE
    interval_ms: 100
    transform:
      mapping:
        - from: INIT
          to: INIT
        - from: NORMAL
          to: NORMAL
        - from: DEGRADED
          to: DEGRADED
        - from: SAFE_STATE
          to: SAFE_STATE
        - from: BOOTLOADER
          to: BOOTLOADER
        - from: DIAGNOSTIC
          to: DIAGNOSTIC

Vehicle.Motorcycle.Nodes.RtCore.ErrorCount:
  type: sensor
  datatype: uint8
  min: 0
  max: 255
  description: Faults detected by the RT_CORE node since boot; saturates at 255. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: RT_CORE_ERROR_COUNT
    interval_ms: 100

Vehicle.Motorcycle.Nodes.RtCore.UptimeSeconds:
  type: sensor
  datatype: uint16
  unit: s
  min: 0
  max: 65535
  description: Seconds since the RT_CORE node booted; saturates at 65535. A decrease means the node restarted. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: RT_CORE_UPTIME
    interval_ms: 100

Vehicle.Motorcycle.Nodes.Safety:
  type: branch
  description: Heartbeat of the SAFETY node.

Vehicle.Motorcycle.Nodes.Safety.Mode:
  type: sensor
  datatype: string
  allowed: [INIT, NORMAL, DEGRADED, SAFE_STATE, BOOTLOADER, DIAGNOSTIC]
  description: Node mode from the SAFETY heartbeat (SAFETY_NODE_MODE). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: SAFETY_NODE_MODE
    interval_ms: 100
    transform:
      mapping:
        - from: INIT
          to: INIT
        - from: NORMAL
          to: NORMAL
        - from: DEGRADED
          to: DEGRADED
        - from: SAFE_STATE
          to: SAFE_STATE
        - from: BOOTLOADER
          to: BOOTLOADER
        - from: DIAGNOSTIC
          to: DIAGNOSTIC

Vehicle.Motorcycle.Nodes.Safety.ErrorCount:
  type: sensor
  datatype: uint8
  min: 0
  max: 255
  description: Faults detected by the SAFETY node since boot; saturates at 255. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: SAFETY_ERROR_COUNT
    interval_ms: 100

Vehicle.Motorcycle.Nodes.Safety.UptimeSeconds:
  type: sensor
  datatype: uint16
  unit: s
  min: 0
  max: 65535
  description: Seconds since the SAFETY node booted; saturates at 65535. A decrease means the node restarted. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: SAFETY_UPTIME
    interval_ms: 100

Vehicle.Motorcycle.Nodes.Conn:
  type: branch
  description: Heartbeat of the CONN node.

Vehicle.Motorcycle.Nodes.Conn.Mode:
  type: sensor
  datatype: string
  allowed: [INIT, NORMAL, DEGRADED, SAFE_STATE, BOOTLOADER, DIAGNOSTIC]
  description: Node mode from the CONN heartbeat (CONN_NODE_MODE). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
