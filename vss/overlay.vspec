          to: DIAGNOSTIC

Vehicle.Motorcycle.Nodes.Linux.ErrorCount:
  type: sensor
  datatype: uint8
  min: 0
  max: 255
  description: Faults detected by the LINUX node since boot; saturates at 255. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: LINUX_ERROR_COUNT
