    interval_ms: 100
    transform:
      mapping:
        - from: INIT
          to: INIT
        - from: NORMAL
          to: NORMAL
        - from: DEGRADED
          to: DEGRADED
        - from: SAFE_STATE
          to: SAFE_STATE
        - from: BOOTLOADER
          to: BOOTLOADER
        - from: DIAGNOSTIC
          to: DIAGNOSTIC

Vehicle.Motorcycle.Nodes.Conn.ErrorCount:
  type: sensor
  datatype: uint8
  min: 0
  max: 255
  description: Faults detected by the CONN node since boot; saturates at 255. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: CONN_ERROR_COUNT
    interval_ms: 100

Vehicle.Motorcycle.Nodes.Conn.UptimeSeconds:
  type: sensor
  datatype: uint16
  unit: s
  min: 0
  max: 65535
  description: Seconds since the CONN node booted; saturates at 65535. A decrease means the node restarted. Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: CONN_UPTIME
    interval_ms: 100

Vehicle.Motorcycle.Nodes.Linux:
  type: branch
  description: Heartbeat of the LINUX node.

Vehicle.Motorcycle.Nodes.Linux.Mode:
  type: sensor
  datatype: string
  allowed: [INIT, NORMAL, DEGRADED, SAFE_STATE, BOOTLOADER, DIAGNOSTIC]
  description: Node mode from the LINUX heartbeat (LINUX_NODE_MODE). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: LINUX_NODE_MODE
