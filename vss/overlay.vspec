  dbc2vss:
    signal: LINUX_UPTIME
    interval_ms: 100

Vehicle.Motorcycle.Validity:
  type: branch
  description: Validity bits of the rt-core VehicleEngine frame (D-108, provisional). kuksa-can-provider cannot gate a value on them, so each is its own leaf; consumers that care read both.

Vehicle.Motorcycle.Validity.EngineSpeed:
  type: sensor
  datatype: boolean
  description: True if ENGINE_SPEED holds a valid ECU sample (DBC ENGINE_SPEED_VALID). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: ENGINE_SPEED_VALID
    interval_ms: 50
    transform:
      mapping:
        - from: INVALID
          to: false
        - from: VALID
          to: true

Vehicle.Motorcycle.Validity.BatteryVoltage:
  type: sensor
  datatype: boolean
  description: True if BATTERY_VOLTAGE holds a valid ECU sample (DBC BATTERY_VOLTAGE_VALID). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: BATTERY_VOLTAGE_VALID
    interval_ms: 50
    transform:
      mapping:
        - from: INVALID
          to: false
        - from: VALID
          to: true

Vehicle.Motorcycle.Validity.CoolantTemp:
  type: sensor
  datatype: boolean
  description: True if COOLANT_TEMP holds a valid ECU sample (DBC COOLANT_TEMP_VALID). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: COOLANT_TEMP_VALID
    interval_ms: 50
    transform:
      mapping:
        - from: INVALID
          to: false
        - from: VALID
          to: true

Vehicle.Motorcycle.Validity.ThrottlePosition:
  type: sensor
  datatype: boolean
  description: True if THROTTLE_POS holds a valid ECU sample (DBC THROTTLE_POS_VALID). Display only, not E2E-checked by kuksa-can-provider, stale after 3 frame cycles (judge by the value timestamp), and must never feed a decision (D-108, provisional).
  dbc2vss:
    signal: THROTTLE_POS_VALID
    interval_ms: 50
    transform:
      mapping:
        - from: INVALID
          to: false
        - from: VALID
          to: true
